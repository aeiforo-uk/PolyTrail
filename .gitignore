# Playwright MCP ephemeral cache
.playwright-mcp/
# Security scan outputs — reveal file paths + line numbers of findings
# (attacker roadmap even when values redacted). Keep results local only.
docs/security/gitleaks-*.json
docs/security/nuclei-*.txt
docs/security/nuclei-*.json
docs/security/semgrep-*.json

# Security — keys, certs, credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
credentials.json
service-account*.json
*-credentials.json
*.secrets
.test-credentials.env
**/CREDENTIALS.md
**/CREDENTIALS.txt
**/*CREDENTIALS*.md
**/*CREDENTIALS*.txt
**/*-credentials*.md
.env.vercel
.env.vercel-*

# SP-2: Marklytics license signing — private key never committed,
# public key IS committed (baked into OCI image via Dockerfile.web).
# Customer license bundles (audit trail) never committed — they carry
# customer-identifying information and stay in 1Password / Marklytics ops.
!ops/marklytics-license-public.pem
license-bundle/

# SP-2 C7 / build-info: generated at prebuild time by
# scripts/generate-{build-info,release-index}.mjs but COMMITTED so
# deploys that strip git/docs (Vercel --archive=tgz from frontend/,
# or a minimal Docker layer) still have valid release + commit
# metadata. The generator is idempotent — re-running with no changes
# rewrites the same content, so merge conflicts are rare and trivial.
# (Prior revision gitignored these and releases broke on Vercel.)
frontend/.build-info-fallback.json

# Playwright MCP + CLI artifacts
.playwright-mcp/
.playwright-cli/
output/playwright/

# Vercel
.vercel/

# Stream D Task 8 — local .eml previews from EMAIL_PROVIDER=file
**/tmp/email/

# graphify knowledge graph — commit graph outputs, ignore only the extraction cache + local state
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.hook.log
graphify-out/.weekly-refresh.log
graphify-out/.labels-backup.md
graphify-out/.SEMANTIC_REBUILD_RECOMMENDED
graphify-out/.graphify_*.json

.vercel

# Invite/magic-link tokens — JWT payload leaks tenant UUIDs even when expired
docs/**/*-invite-link.txt
docs/**/*invite*.txt

# Generated Obsidian vault — 4600+ node files, regenerated by `graphify`
graphify-out/obsidian/

# Perf test runs — timestamped output, not build-stable
perf/run-*.txt
perf/run-*.json

# Backup files left by editors
**/*.bak
**/*.orig
**/*~

# Scratch artifacts at repo root — screenshots, scratch docs, temp dirs.
# These are local working files; never let `git add -A` sweep them into history.
# (.docx in particular may carry customer-identifying content — keep it OUT of git.)
/*.png
/*.docx
/*.pdf
.tmp/

# Duplicate graphify output dir created under frontend/ — the canonical
# graph lives at repo-root graphify-out/. Ignore the frontend copy.
frontend/graphify-out/

# The battery-passport product this was rebuilt from. Reference only, kept on
# disk but never published: it is a different product, it is 84% of the file
# count, and its own .gitignore deliberately un-ignores an .env carrying test
# account passwords.
_legacy-battery-passport/

# Claude Code MCP server config — carries API keys for local tooling.
.mcp.json
.claude/settings.local.json
.neon

# ─────────────────────────────────────────────────────────────
# Polytrail — environment configuration
# Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres 16+). Local docker-compose maps 5433 to avoid clashes.
DATABASE_URL=postgresql://polytrail:polytrail@localhost:5434/polytrail

# Session signing — 32+ random bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Passport issuer identity. The DID that signs verifiable credentials.
# Generated per-tenant at runtime; this is the platform fallback issuer.
PLATFORM_DID_SEED=

# Public passport resolver base — the host printed into QR codes / GS1 Digital Link.
NEXT_PUBLIC_RESOLVER_BASE_URL=http://localhost:3000

# Wraps each tenant's private signing key (AES-256-GCM, HKDF-derived).
# Required only to issue verifiable credentials; everything else works without it.
CREDENTIAL_KEY_SECRET=

# Guards the webhook retry drain at /api/webhooks/retry. Without it the endpoint
# refuses to run, and failed deliveries get one attempt and no retries.
WEBHOOK_CRON_SECRET=

# Encrypts stored connector credentials (AES-256-GCM). 32+ chars.
# Falls back to deriving from AUTH_SECRET, but rotating the session secret would
# then make every stored credential unreadable — set this one explicitly.
CONNECTOR_SECRET=

# Seals TOTP secrets and recovery-code digests. MFA enrolment is refused
# without it rather than storing secrets in the clear.
MFA_ENCRYPTION_KEY=

# ── EU DPP Registry ──────────────────────────────────────────────────────────
# `mock` behaves like the real registry without talking to it, and is the right
# default: the Registry went live on 20 July 2026 but created no textile
# obligation, so nothing here should be filing today.
EU_REGISTRY_MODE=mock
EU_REGISTRY_URL=
EU_REGISTRY_API_KEY=
# Must be exactly `true` for a filing to count as a filing of record. A staging
# endpoint cannot be allowed to masquerade as the Commission's.
EU_REGISTRY_AUTHORITATIVE=false
EU_REGISTRY_RESOLVER_BASE=
REGISTRY_SERVICE_PROVIDER_REF=

# Optional: object storage for product imagery and evidence documents
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: transactional email
SMTP_URL=
EMAIL_FROM="Polytrail <no-reply@polytrail.example>"

# Optional: rate limiting (falls back to in-process limiter when unset)
REDIS_URL=

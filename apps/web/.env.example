# ─────────────────────────────────────────────────────────────
# Polytrail — environment configuration
# Copy to .env.local for local development.
#
# Every variable below is read by application code. Nothing here is
# aspirational: if a feature is not built, its variable is not listed, because
# a documented variable that nothing reads costs someone an afternoon of
# wondering why setting it changed nothing.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Without these two the app does not run.

NODE_ENV=development

# Postgres 16+. Local docker-compose maps 5434 to avoid clashing with a system
# Postgres. On a serverless host use the *pooled* connection string; the direct
# one is for migrations.
DATABASE_URL=postgresql://polytrail:polytrail@localhost:5434/polytrail

# Session signing. Must be at least 32 characters or sign-in throws. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ── Addresses ────────────────────────────────────────────────────────────────

# The origin this deployment is reachable at. Used for metadata and for every
# link posted into an email — invitations, ownership transfers, supplier magic
# links. A blank value is treated as unset; on Vercel it falls back to the
# deployment's own domain, so emailed links still resolve.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The host in a passport's public URL. Falls back to NEXT_PUBLIC_APP_URL, so
# set it only when passports live on a different domain from the console.
NEXT_PUBLIC_RESOLVER_BASE_URL=

# The GS1 resolver domain encoded into QR codes. When set *and* the passport
# has a valid GTIN, the code carries a GS1 Digital Link that retail and customs
# systems already resolve; otherwise it falls back to the passport's own URL,
# which only works inside Polytrail.
NEXT_PUBLIC_RESOLVER_DOMAIN=

# ── Secrets for individual features ──────────────────────────────────────────
# Each one disables exactly one capability when absent, loudly rather than
# silently.

# Wraps each tenant's private signing key (AES-256-GCM, HKDF-derived).
# Required only to issue verifiable credentials.
CREDENTIAL_KEY_SECRET=

# Guards the webhook retry drain at /api/webhooks/retry. Without it the endpoint
# returns 503, and failed deliveries get one attempt and no retries.
WEBHOOK_CRON_SECRET=

# Encrypts stored connector credentials (AES-256-GCM). 32+ chars.
# Falls back to deriving from AUTH_SECRET, but rotating the session secret would
# then make every stored credential unreadable — set this one explicitly.
CONNECTOR_SECRET=

# Seals TOTP secrets and recovery-code digests. MFA enrolment is refused
# without it rather than storing secrets in the clear.
MFA_ENCRYPTION_KEY=

# ── EU DPP Registry ──────────────────────────────────────────────────────────
# `mock` behaves like the real registry without talking to it, and is the right
# default: the Registry went live on 20 July 2026 but created no textile
# obligation, so nothing here should be filing today.
EU_REGISTRY_MODE=mock
EU_REGISTRY_URL=
EU_REGISTRY_API_KEY=
# Must be exactly `true` for a filing to count as a filing of record. A staging
# endpoint cannot be allowed to masquerade as the Commission's.
EU_REGISTRY_AUTHORITATIVE=false
EU_REGISTRY_RESOLVER_BASE=
REGISTRY_SERVICE_PROVIDER_REF=

# ── Optional: email ──────────────────────────────────────────────────────────
# The provider is chosen in this order: EMAIL_PROVIDER if set, else Resend if
# RESEND_API_KEY is present, else SMTP if SMTP_URL is, else `file`. With none of
# them, mail is written to disk instead of sent — so invitations and transfers
# are generated but never arrive.
EMAIL_PROVIDER=
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM="Polytrail <no-reply@polytrail.example>"
# Where the `file` provider writes. Defaults to .outbox/ in the app directory.
EMAIL_OUTBOX=

# ── Optional: tuning ─────────────────────────────────────────────────────────
# Postgres pool size per instance. Defaults to 10.
DATABASE_POOL_MAX=

# The workspace `/p/demo` resolves into. Defaults to the seed's demo workspace;
# an install without that workspace answers 404 rather than handing a stranger
# a real customer's passport.
DEMO_TENANT_SLUG=meridian

# ─────────────────────────────────────────────────────────────────────────────
# Deliberately absent, and worth knowing why:
#
#   S3_*        Evidence documents and product imagery are stored in Postgres,
#               content-addressed by SHA-256 — see src/lib/documents/storage.ts.
#               There is no object-storage backend to configure.
#   REDIS_URL   The rate limiter is in-process. A shared counter is a known gap
#               (docs/STATUS.md), not a configuration option.
#   PLATFORM_DID_SEED
#               Issuer identity is generated per tenant at runtime. No platform
#               fallback seed is read anywhere.
# ─────────────────────────────────────────────────────────────────────────────
